# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL=
SESSION_SECRET=

# Cloudflare R2 (optional until the R2 media adapter is implemented)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public custom-domain base URL; leave blank for private media.
R2_PUBLIC_BASE_URL=
