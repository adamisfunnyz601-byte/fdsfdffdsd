# Copy these into Enzonic's environment-variable settings.
# Never commit a real .env file or real secret values.

# Required: Neon PostgreSQL pooled connection string.
DATABASE_URL=

# Required: generate a stable random secret of at least 32 characters.
SESSION_SECRET=

# Required: the public base URL Enzonic assigns to this API (no trailing slash).
PUBLIC_API_URL=

# Required for browser clients on your Nexus frontend domain.
# Example: https://nexuss.devs.li
APP_ORIGIN=

# Use production mode. Enzonic may set this automatically.
NODE_ENV=production

# Optional: passkey origin fallback. Usually your frontend's HTTPS origin.
WEBAUTHN_ORIGIN=

# Optional: passkey relying-party ID. Usually the domain only, e.g. devs.li or your app host.
WEBAUTHN_RP_ID=

# Optional: required only if the Apple 2FA relay feature is used; use a random secret of 40+ characters.
APPLE_2FA_RELAY_SECRET=

# Optional: JSON array of WebRTC STUN/TURN servers. Leave blank to use the built-in Google STUN fallback.
WEBRTC_ICE_SERVERS=

# Optional: GIPHY API key for GIF search.
GIPHY_API_KEY=

# PORT is supplied by the hosting platform; do not hard-code it.
