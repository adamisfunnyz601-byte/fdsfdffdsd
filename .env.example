# Copy these into Enzonic's environment-variable settings.
# Never commit a real .env file or real secret values.

# Required: Enzonic pooled PostgreSQL connection string for chat/messages.
MESSAGES_URL=

# Required: Enzonic pooled PostgreSQL connection string for accounts/users.
ACCOUNTS_URL=

# Legacy aliases (only needed for older deployments; runtime falls back to these).
DATABASE_URL=

# Required: generate a stable random secret of at least 32 characters.
SESSION_SECRET=

# Required for owner-only administrative access. Generate a new random value; do not reuse the old committed key.
OWNER_KEY=

# Required: the public base URL Enzonic assigns to this API (no trailing slash).
PUBLIC_API_URL=

# Required for browser clients on your Nexus frontend domain.
# Example: https://nexuss.devs.li
APP_ORIGIN=

# Use production mode. Enzonic may set this automatically.
NODE_ENV=production

# Optional: passkey origin fallback. Usually your frontend's HTTPS origin.
WEBAUTHN_ORIGIN=

# Optional: passkey relying-party ID. Usually the domain only, e.g. devs.li or your app host.
WEBAUTHN_RP_ID=

# Optional: required only if the Apple 2FA relay feature is used; use a random secret of 40+ characters.
APPLE_2FA_RELAY_SECRET=

# Optional: JSON array of WebRTC STUN/TURN servers. Leave blank to use the built-in Google STUN fallback.
WEBRTC_ICE_SERVERS=

# Optional: GIPHY API key for GIF search.
GIPHY_API_KEY=

# Neon chat database cleanup policy.
# At 875 MB used, target approximately 512 MB of the oldest message payloads.
DATABASE_STORAGE_LIMIT_MB=1024
DATABASE_CLEANUP_TRIGGER_MB=875
DATABASE_CLEANUP_BATCH_MB=512

# Legacy alias for ACCOUNTS_URL. Keep unset when using the current variable names.
ENZONIC_DATABASE_URL=
ENZONIC_DATABASE_STORAGE_LIMIT_MB=3072
ENZONIC_CLEANUP_TRIGGER_MB=2700
ENZONIC_CLEANUP_BATCH_MB=1536

# PORT is supplied by the hosting platform; do not hard-code it.

# Free hosted YouTube converter via Yoinku (no Docker or paid credits required).
# Free plan: 5 downloads per day per account; API key is free.
YOINKU_API_KEY=

# Optional: paths to locally installed yt-dlp and FFmpeg binaries for YouTube conversion
YTDLP_PATH=yt-dlp
FFMPEG_LOCATION=
